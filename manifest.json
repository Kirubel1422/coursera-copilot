{
  "manifest_version": 3,
  "name": "Coursera Autopilot",
  "version": "1.3.0",
  "description": "Automatically speeds up and advances through Coursera video lectures.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://coursera.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*", "https://coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
